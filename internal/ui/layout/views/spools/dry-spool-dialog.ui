<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name dry-spool-dialog.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkWindow" id="dialog">
    <property name="default-height">240</property>
    <property name="default-width">360</property>
    <property name="modal">true</property>
    <child>
      <object class="GtkBox" id="box">
        <property name="margin-bottom">16</property>
        <property name="margin-end">16</property>
        <property name="margin-start">16</property>
        <property name="margin-top">16</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkLabel" id="spoolLabel">
            <property name="halign">start</property>
            <property name="label">Spool label</property>
            <property name="wrap">true</property>
            <style>
              <class name="heading"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="parametersGrid">
            <property name="column-spacing">10</property>
            <property name="row-spacing">8</property>
            <child>
              <object class="GtkLabel" id="temperatureLabel">
                <property name="halign">end</property>
                <property name="label">Temperature label</property>
                <layout>
                  <property name="column">0</property>
                  <property name="column-span">1</property>
                  <property name="row">0</property>
                  <property name="row-span">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="temperatureEntry">
                <property name="hexpand">true</property>
                <layout>
                  <property name="column">1</property>
                  <property name="column-span">1</property>
                  <property name="row">0</property>
                  <property name="row-span">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="durationLabel">
                <property name="halign">end</property>
                <property name="label">Duration label</property>
                <layout>
                  <property name="column">0</property>
                  <property name="column-span">1</property>
                  <property name="row">1</property>
                  <property name="row-span">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="durationEntry">
                <property name="hexpand">true</property>
                <layout>
                  <property name="column">1</property>
                  <property name="column-span">1</property>
                  <property name="row">1</property>
                  <property name="row-span">1</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="errorLabel">
            <property name="halign">start</property>
            <property name="label"/>
            <property name="wrap">true</property>
            <style>
              <class name="error"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="actions">
            <property name="halign">end</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="cancelBtn">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="saveBtn">
                <property name="label">Save</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
