<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name spool-dialog.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkWindow" id="dialog">
    <property name="default-height">-1</property>
    <property name="default-width">480</property>
    <property name="modal">true</property>
    <child>
      <object class="GtkBox" id="box">
        <property name="margin-bottom">16</property>
        <property name="margin-end">16</property>
        <property name="margin-start">16</property>
        <property name="margin-top">16</property>
        <property name="orientation">vertical</property>
        <property name="spacing">16</property>
        <child>
          <object class="AdwPreferencesGroup" id="box_slot_1_spool_form">
            <child>
              <object class="AdwEntryRow" id="box_slot_1_manufacturer_entry">
                <property name="title">Manufacturer</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="box_slot_1_material_combo">
                <property name="title">Material</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="box_slot_1_color_entry">
                <property name="title">Color</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="box_slot_1_color_row">
                <property name="activatable-widget">box_slot_1_color_picker_button</property>
                <property name="title">Color HEX</property>
                <child type="suffix">
                  <object class="GtkColorDialogButton" id="box_slot_1_color_picker_button">
                    <property name="dialog">box_slot_1_color_picker_dialog</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="box_slot_1_weight_entry">
                <property name="input-purpose">number</property>
                <property name="title">Net weight (g)</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="box_slot_1_price_entry">
                <property name="input-purpose">number</property>
                <property name="title">Price</property>
              </object>
            </child>
            <child>
              <object class="AdwExpanderRow" id="box_slot_1_additional_row">
                <property name="expanded">False</property>
                <property name="title">Additional settings</property>
                <child>
                  <object class="AdwEntryRow" id="box_slot_1_diameter_entry">
                    <property name="input-purpose">number</property>
                    <property name="title">Filament diameter (mm)</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="box_slot_1_density_entry">
                    <property name="input-purpose">number</property>
                    <property name="title">Filament density (g/cm³)</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="errorLabel">
            <property name="halign">start</property>
            <property name="label"/>
            <property name="visible">false</property>
            <property name="wrap">true</property>
            <style>
              <class name="error"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="actions">
            <property name="halign">end</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="cancelBtn">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="saveBtn">
                <property name="label">Save</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkColorDialog" id="box_slot_1_color_picker_dialog">
    <property name="modal">true</property>
    <property name="with-alpha">false</property>
  </object>
  <object class="GtkBox" id="box_slot_1_color_picker_root">
    <property name="orientation">horizontal</property>
    <property name="spacing">8</property>
    <child>
      <object class="GtkLabel" id="box_slot_1_color_picker_label">
        <property name="halign">start</property>
        <property name="hexpand">true</property>
        <property name="label">Label</property>
      </object>
    </child>
  </object>
</interface>
