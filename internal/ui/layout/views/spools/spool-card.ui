<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name spool-card.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkBox" id="card">
    <property name="height-request">-1</property>
    <property name="margin-bottom">2</property>
    <property name="margin-end">2</property>
    <property name="margin-start">2</property>
    <property name="margin-top">2</property>
    <property name="orientation">vertical</property>
    <property name="spacing">10</property>
    <property name="width-request">270</property>
    <child>
      <object class="GtkBox" id="content">
        <property name="margin-end">14</property>
        <property name="margin-start">14</property>
        <property name="margin-top">14</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkDrawingArea" id="content_slot_1_area">
            <property name="content-height">58</property>
            <property name="content-width">58</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="labels">
            <property name="hexpand">true</property>
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="name">
                <property name="halign">start</property>
                <property name="label">Name</property>
                <property name="max-width-chars">24</property>
                <property name="wrap">true</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="details">
                <property name="halign">start</property>
                <property name="label">Details</property>
                <property name="wrap">true</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkDrawingArea" id="card_slot_2_area">
        <property name="content-height">8</property>
        <property name="content-width">100</property>
        <property name="hexpand">true</property>
        <property name="margin-end">14</property>
        <property name="margin-start">14</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="weight">
        <property name="halign">start</property>
        <property name="label">Weight</property>
        <property name="margin-end">14</property>
        <property name="margin-start">14</property>
        <style>
          <class name="caption"/>
          <class name="dim-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="card_slot_4_section">
        <property name="margin-end">14</property>
        <property name="margin-start">14</property>
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <child>
          <object class="GtkSeparator" id="card_slot_4_separator">
            <property name="margin-bottom">4</property>
            <property name="orientation">horizontal</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="card_slot_4_section_slot_2_label">
            <property name="halign">start</property>
            <property name="label">Label</property>
            <property name="wrap">true</property>
            <style>
              <class name="caption"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="card_slot_4_section_slot_3_label">
            <property name="halign">start</property>
            <property name="label">Label</property>
            <property name="wrap">true</property>
            <style>
              <class name="caption"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="actions">
        <property name="halign">end</property>
        <property name="margin-bottom">12</property>
        <property name="margin-end">14</property>
        <property name="margin-start">14</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkButton" id="actions_slot_1_button">
            <property name="icon-name">weather-windy-symbolic</property>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="actions_slot_2_button">
            <property name="icon-name">document-edit-symbolic</property>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="actions_slot_3_button">
            <property name="icon-name">edit-delete-symbolic</property>
            <style>
              <class name="circular"/>
              <class name="destructive-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="card"/>
    </style>
  </object>
</interface>
