<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name dashboard-metrics.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkFlowBox" id="grid">
    <property name="column-spacing">6</property>
    <property name="hexpand">true</property>
    <property name="homogeneous">true</property>
    <property name="max-children-per-line">5</property>
    <property name="min-children-per-line">1</property>
    <property name="row-spacing">6</property>
    <property name="selection-mode">none</property>
    <child>
      <object class="GtkBox" id="total_prints_card">
        <property name="height-request">112</property>
        <property name="margin-bottom">2</property>
        <property name="margin-end">2</property>
        <property name="margin-start">2</property>
        <property name="margin-top">2</property>
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="width-request">150</property>
        <child>
          <object class="GtkBox" id="total_prints_header">
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="margin-top">12</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkImage" id="total_prints_icon">
                <property name="icon-name">printer-symbolic</property>
                <style>
                  <class name="accent"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="total_prints_label">
                <property name="ellipsize">end</property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <property name="label">Label</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="total_prints_valueLabel">
            <property name="ellipsize">end</property>
            <property name="halign">fill</property>
            <property name="label">—</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="xalign">0</property>
            <style>
              <class name="title-1"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="total_prints_detail">
            <property name="ellipsize">end</property>
            <property name="halign">start</property>
            <property name="label">Detail</property>
            <property name="margin-bottom">10</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="visible">false</property>
            <style>
              <class name="caption"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <style>
          <class name="card"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="success_rate_card">
        <property name="height-request">112</property>
        <property name="margin-bottom">2</property>
        <property name="margin-end">2</property>
        <property name="margin-start">2</property>
        <property name="margin-top">2</property>
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="width-request">150</property>
        <child>
          <object class="GtkBox" id="success_rate_header">
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="margin-top">12</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
