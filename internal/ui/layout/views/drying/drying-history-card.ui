<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name drying-history-card.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkBox" id="card">
    <property name="margin-bottom">4</property>
    <property name="margin-end">4</property>
    <property name="margin-start">4</property>
    <property name="margin-top">4</property>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <child>
      <object class="GtkBox" id="row">
        <property name="margin-bottom">12</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <property name="margin-top">12</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <child>
          <object class="GtkDrawingArea" id="row_slot_1_area">
            <property name="content-height">58</property>
            <property name="content-width">58</property>
            <property name="valign">center</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="identity">
            <property name="hexpand">true</property>
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="name">
                <property name="halign">start</property>
                <property name="label">Name</property>
                <property name="wrap">true</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="details">
                <property name="halign">start</property>
                <property name="label">Details</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="result">
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLabel" id="parameters">
                <property name="halign">end</property>
                <property name="label">45 °C · 4 hours</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="date">
                <property name="halign">end</property>
                <property name="label">Date</property>
                <style>
                  <class name="caption"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="card"/>
    </style>
  </object>
</interface>
