<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name drying-recommendation-card.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkBox" id="card">
    <property name="height-request">128</property>
    <property name="margin-bottom">2</property>
    <property name="margin-end">2</property>
    <property name="margin-start">2</property>
    <property name="margin-top">2</property>
    <property name="orientation">vertical</property>
    <property name="spacing">5</property>
    <property name="width-request">190</property>
    <child>
      <object class="GtkLabel" id="material">
        <property name="halign">start</property>
        <property name="label">Material</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <property name="margin-top">12</property>
        <style>
          <class name="heading"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="parameters">
        <property name="halign">start</property>
        <property name="label">45 °C · 4 hours</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <style>
          <class name="title-3"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="interval">
        <property name="halign">start</property>
        <property name="label">Drying interval</property>
        <property name="margin-bottom">12</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <property name="wrap">true</property>
        <style>
          <class name="caption"/>
          <class name="dim-label"/>
        </style>
      </object>
    </child>
    <style>
      <class name="card"/>
    </style>
  </object>
</interface>
