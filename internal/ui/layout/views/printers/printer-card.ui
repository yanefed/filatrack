<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name printer-card.ui -->
  <requires lib="gtk" version="4.10"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="GtkBox" id="card">
    <property name="margin-bottom">4</property>
    <property name="margin-end">4</property>
    <property name="margin-start">4</property>
    <property name="margin-top">4</property>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    <child>
      <object class="GtkBox" id="content">
        <property name="margin-bottom">12</property>
        <property name="margin-end">12</property>
        <property name="margin-start">12</property>
        <property name="margin-top">12</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkBox" id="content_slot_1_row">
            <property name="margin-bottom">8</property>
            <property name="margin-top">6</property>
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkBox" id="content_slot_1_header">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkBox" id="content_slot_1_dot">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">0</property>
                    <style>
                      <class name="printer-status-dot"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="content_slot_1_info">
                    <property name="ellipsize">end</property>
                    <property name="halign">start</property>
                    <property name="hexpand">true</property>
                    <property name="label"/>
                    <property name="max-width-chars">80</property>
                    <style>
                      <class name="heading"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="content_slot_1_file">
                <property name="ellipsize">end</property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <property name="label"/>
                <property name="max-width-chars">80</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkProgressBar" id="content_slot_1_bar">
                <property name="show-text">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="endpoint">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkImage" id="endpointIcon">
                <property name="icon-name">network-server-symbolic</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="endpointLabel">
                <property name="ellipsize">middle</property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <property name="label">Endpoint label</property>
                <style>
                  <class name="caption"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="separator">
            <property name="orientation">horizontal</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="assignment">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkLabel" id="assignmentLabel">
                <property name="halign">start</property>
                <property name="label">Assignment label</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="dropdown">
                <property name="hexpand">true</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="editButton">
                <property name="icon-name">document-edit-symbolic</property>
                <style>
                  <class name="circular"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="card"/>
    </style>
  </object>
</interface>
